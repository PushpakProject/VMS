{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vms.example/contracts/video-uploaded.v1.schema.json",
  "title": "video.uploaded.v1",
  "description": "Published by api-service (outbox) when an upload is verified. Kafka key = payload.videoId.",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "VIDEO_UPLOADED" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "required": ["videoId", "ownerId", "trackingId", "run", "rawObjectKey", "finalObjectKey", "contentType", "sizeBytes"],
      "properties": {
        "videoId": { "type": "string", "format": "uuid" },
        "ownerId": { "type": "string", "format": "uuid" },
        "trackingId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,64}$" },
        "run": { "type": "integer", "minimum": 1, "description": "Processing run; increments on retry/reprocess." },
        "rawObjectKey": { "type": "string" },
        "finalObjectKey": { "type": "string" },
        "contentType": { "enum": ["video/webm", "video/mp4"] },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
