# Local stack configuration. Copy to infra/.env and replace every placeholder:
#   cp .env.example infra/.env
# Generate secrets with:  openssl rand -base64 48
# Never commit real values; infra/.env is gitignored. Production values live in Secret Manager.

VMS_DB_PASSWORD=change-me-local-db-password
# Base64, at least 32 bytes decoded.
VMS_JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_48
# At least 32 characters; signs the local storage emulator URLs.
VMS_LOCAL_SIGNING_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHAR_VALUE

# Optional: Google Sign-In (OAuth 2.0 Web client id; origin http://localhost:8088).
VMS_GOOGLE_CLIENT_ID=

# Test accounts created on start-up (only if both values are set).
VMS_DEMO_USER_EMAIL=operator@vms.local
VMS_DEMO_USER_PASSWORD=change-me-operator-password
VMS_DEMO_ADMIN_EMAIL=admin@vms.local
VMS_DEMO_ADMIN_PASSWORD=change-me-admin-password
