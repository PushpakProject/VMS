# Local development: plain HTTP on localhost (a secure context, so the camera works).
server {
    listen 80;
    server_name _;
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    # Local storage emulator uploads pass through the API; production uploads go straight to GCS.
    client_max_body_size 110m;

    location /api/ {
        proxy_pass http://api:8080;
        # Keep host:port so the API sees the same origin as the browser (CORS same-origin check).
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    location /actuator/ {
        return 404;
    }

    location /assets/ {
        expires 1y;
    }

    location / {
        try_files $uri /index.html;
    }
}
